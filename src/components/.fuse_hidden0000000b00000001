"use client";

import { useState } from "react";
import { useLang } from "@/lib/language";
import LanguageToggle from "@/components/LanguageToggle";

const links = [
  { href: "/#rooms", en: "Rooms", id: "Kamar" },
  { href: "/#facilities", en: "Facilities", id: "Fasilitas" },
  { href: "/#gallery", en: "Gallery", id: "Galeri" },
  { href: "/#location", en: "Location", id: "Lokasi" },
  { href: "/#reviews", en: "Reviews", id: "Ulasan" },
];

export default function Header() {
  const [open, setOpen] = useState(false);
  const lang = useLang();
  const t = (en: string, id: string) => (lang === "id" ? id : en);
  const close = () => setOpen(false);

  return (
    <header className="sticky top-0 z-40 bg-linen/85 backdrop-blur-md">
      <div className="flex items-center justify-between gap-3 sm:gap-6 px-6 md:px-12 py-5">
        <a href="/" onClick={close} className="font-serif text-xl sm:text-2xl whitespace-nowrap text-ink">
          Serene Stay
        </a>

        <nav className="hidden lg:flex items-center gap-8 text-sm text-ink">
          {links.map((l) => (
            <a key={l.href} href={l.href} className="hover:text-teak-dark">
              {t(l.en, l.id)}
            </a>
          ))}
        </nav>

        <div className="flex items-center gap-2 sm:gap-3">
          <LanguageToggle className="hidden md:flex" />
          <a
            href="/#booking"
            onClick={close}
            className="whitespace-nowrap border border-teak rounded-full px-3 sm:px-5 py-2 text-sm font-medium text-ink hover:bg-sage transition-colors"
          >
            {t("Book Now", "Pesan")}
          </a>
          <button
            type="button"
            onClick={() => setOpen(!open)}
            aria-label={open ? t("Close menu", "Tutup menu") : t("Open menu", "Buka menu")}
            aria-expanded={open}
            aria-controls="mobile-menu"
            className="lg:hidden flex h-11 w-11 items-center justify-center rounded-xl border border-teak/40 text-ink"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" aria-hidden="true">
              {open ? <path d="M6 6l12 12M18 6L6 18" /> : <path d="M4 7h16M4 12h16M4 17h10" />}
            </svg>
          </button>
        </div>
      </div>

      {open && (
        <nav id="mobile-menu" className="lg:hidden border-t border-teak/30 px-6 pb-4">
          <ul>
            {links.map((l) => (
              <li key={l.href} className="border-b border-teak/20 last:border-0">
                <a href={l.href} onClick={close} className="block py-3 text-base text-ink">
                  {t(l.en, l.id)}
                </a>
              </li>
            ))}
          </ul>
          <LanguageToggle className="mt-4 flex w-fit md:hidden" />
        </nav>
      )}
    </header>
  );
}
